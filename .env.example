# Биржа: binance, bybit, okx, kraken и др. (см. https://docs.ccxt.com)
EXCHANGE_ID=binance

# API-ключи (для paper-режима не обязательны)
API_KEY=
API_SECRET=

# true — только симуляция, без реальных ордеров
PAPER_TRADING=true

# Торговая пара
SYMBOL=BTC/USDT

# Таймфрейм свечей: 1m, 5m, 15m, 1h, 4h, 1d
TIMEFRAME=1h

# Скользящие средние (быстрая / медленная)
FAST_MA_PERIOD=9
SLOW_MA_PERIOD=21

# Доля баланса USDT на одну сделку (0.0–1.0)
TRADE_SIZE_RATIO=0.95

# Интервал опроса в секундах
POLL_INTERVAL_SEC=60

# Начальный баланс для paper-режима
PAPER_USDT_BALANCE=10000
PAPER_BASE_BALANCE=0
