# Режим: true = виртуальный портфель (MOEX ISS), false = ордера через Finam (фаза 2)
PAPER_TRADING=true

# Finam Trade API (фаза 2) — https://tradeapi.finam.ru/
FINAM_TOKEN=

# Доли рукавов (сумма = 1.0)
CORE_WEIGHT=0.8
SATELLITE_WEIGHT=0.2

# Начальный капитал paper, руб
PAPER_INITIAL_RUB=1000000

# Core: дневные свечи, momentum
CORE_MA_FAST=50
CORE_MA_SLOW=200
CORE_MOMENTUM_MONTHS=6
CORE_UNIVERSE=SBMX,TMOS,TRUR,SBGB,TGLD@,SBER,LKOH,GAZP

# Satellite: часовые свечи (в paper — дневки как упрощение)
SATELLITE_UNIVERSE=VTBR,AFKS,MTSS
SATELLITE_BREAKOUT_BARS=20
SATELLITE_ATR_PERIOD=14

# Риск
MAX_DRAWDOWN_PCT=20
SATELLITE_MONTHLY_LOSS_CAP_PCT=10
MIN_DAILY_VOLUME_RUB=5000000

# Цикл бота
POLL_INTERVAL_SEC=300

# Ребаланс 80/20 от текущего equity (сек). 604800 = раз в 7 дней
REBALANCE_INTERVAL_SEC=604800

# Satellite: фильтры точности
MARKET_INDEX=IMOEX
SATELLITE_MIN_RVOL=1.5
SATELLITE_INDEX_SMA_PERIOD=20
SATELLITE_TICKER_SMA_PERIOD=50
SATELLITE_REQUIRE_CLOSE_CONFIRM=true
