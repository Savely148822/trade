# Режим: true = виртуальный портфель (MOEX ISS), false = ордера через Finam (фаза 2)
PAPER_TRADING=true

# Finam Trade API (фаза 2) — https://tradeapi.finam.ru/
FINAM_TOKEN=

# Доли рукавов (сумма = 1.0)
CORE_WEIGHT=0.8
SATELLITE_WEIGHT=0.2

# Начальный капитал paper и ежемесячное пополнение (зарплата), руб
PAPER_INITIAL_RUB=10000
MONTHLY_DEPOSIT_RUB=2000

# Core: momentum (стартовый список — bot/universe.py)
CORE_MA_FAST=50
CORE_MA_SLOW=200
CORE_MOMENTUM_MONTHS=6
CORE_UNIVERSE=SBMX,TMOS,TRUR,SBGB,LQDT,SBER,LKOH,GAZP,NVTK,YDEX,PLZL,TATN

# DCA: после каждого пополнения core-доля уходит в БПИФ (отдельно от momentum)
CORE_DCA_ENABLED=true
CORE_DCA_UNIVERSE=TMOS,TRUR,LQDT,SBGB

# Satellite: импульс (ликвидные акции MOEX)
SATELLITE_UNIVERSE=VTBR,AFKS,MTSS,AFLT,MAGN,CHMF,ALRS
SATELLITE_MIN_EQUITY_RUB=50000

# Комиссии и минимальный размер сделки (руб)
COMMISSION_PCT=0.1
MIN_TRADE_RUB=3000
DCA_MIN_TRADE_RUB=400
INFLATION_ANNUAL_PCT=8

# Бэктест: python -m bot.backtest  (по умолчанию ~2 года, 10k + 2k/мес)
BACKTEST_START=2023-05-26
BACKTEST_END=2025-05-26
BACKTEST_INITIAL_RUB=10000
BACKTEST_MONTHLY_DEPOSIT_RUB=2000

SATELLITE_BREAKOUT_BARS=20
SATELLITE_ATR_PERIOD=14

# Риск
MAX_DRAWDOWN_PCT=20
SATELLITE_MONTHLY_LOSS_CAP_PCT=10
MIN_DAILY_VOLUME_RUB=5000000

# Цикл бота
POLL_INTERVAL_SEC=300

# Плановый ребаланс 80/20 (сек). 2592000 ≈ 30 дней
REBALANCE_INTERVAL_SEC=2592000

# Satellite: фильтры
MARKET_INDEX=IMOEX
SATELLITE_MIN_RVOL=1.5
SATELLITE_INDEX_SMA_PERIOD=20
SATELLITE_TICKER_SMA_PERIOD=50
SATELLITE_REQUIRE_CLOSE_CONFIRM=true
SATELLITE_PROFIT_REBALANCE_PCT=20
